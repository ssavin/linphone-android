<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="vector"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- KiwiCall pulse glyph, shrunk into the top-left to leave room for the
         "not registered" badge below - same glyph as kiwicall_notification.xml,
         scaled 0.75x and anchored near the top-left corner. -->
    <path
        android:name="pulse"
        android:pathData="M15.5,7.25L12.5,7.25L10.25,14L5.75,0.5L3.5,7.25L0.5,7.25"
        android:strokeColor="#ffffff"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <!-- Small "disconnected" badge: circle with a cross, bottom-right corner. -->
    <path
        android:name="badge_circle"
        android:pathData="M18.5,14 A4.5,4.5 0 1 1 18.499,14"
        android:strokeColor="#ffffff"
        android:strokeWidth="1.3"/>
    <path
        android:name="badge_cross"
        android:pathData="M15.7,15.7L21.3,21.3M21.3,15.7L15.7,21.3"
        android:strokeColor="#ffffff"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"/>
</vector>
