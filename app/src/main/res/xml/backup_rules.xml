<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
    -->
    <exclude domain="sharedpref" path="encrypted.pref"/>
    <!--
      Shared contacts (kiwicall_shared friend list) always come from the
      server (see SharedContactsManager) - restoring the old local copy
      on a fresh install brings back stale/broken state instead of a
      real resync, which is worse than starting empty.
    -->
    <exclude domain="file" path="kiwicall-friends.db"/>
    <exclude domain="file" path="kiwicall-friends.db-wal"/>
    <exclude domain="file" path="kiwicall-friends.db-shm"/>
</full-backup-content>